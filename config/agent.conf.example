# config/agent.conf.example
# Copy to agent.conf and fill in your values

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_GROUP_ID=""

# --- Heartbeat ---
HEARTBEAT_INTERVAL_MIN=30
HEARTBEAT_TIMEOUT_SEC=3600
# Hard cap (seconds) on a single provider run, enforced INSIDE the container by
# `timeout`. Stops a hung claude/qwen from holding the lock and wedging the agent.
# below HEARTBEAT_TIMEOUT_SEC so the per-provider guard fires first.
# Exported so the provider's `bash -c` subshell inherits it (lib/provider.sh runs
# the command in a child shell — an unexported var would not be seen).
export PROVIDER_TIMEOUT_SEC=3540
# How long to wait for a Telegram message before looping (seconds).
# Higher = less disk activity on NAS. Max ~55 (Telegram API limit).
POLL_TIMEOUT=55

# --- Default AI Provider ---
DEFAULT_PROVIDER="claude"

# --- Provider Commands ---
# {prompt_file} = path to temp file containing the prompt (safe, no injection)
# {workdir} = working directory inside the container
#
# In-container local mode — supervisor runs INSIDE the ai-agent container, so
# providers execute as direct CLIs (no nested docker). timeout guards a hung run
# (exit 124 → lib/provider.sh reports a timeout). Uses the exported PROVIDER_TIMEOUT_SEC.
PROVIDER_CMD_claude='cd {workdir} && timeout ${PROVIDER_TIMEOUT_SEC:-3540} claude --dangerously-skip-permissions -p "$(cat {prompt_file})"'
PROVIDER_CMD_qwen='cd {workdir} && timeout ${PROVIDER_TIMEOUT_SEC:-3540} qwen -y -p "$(cat {prompt_file})"'
PROVIDER_CMD_minimax='cd {workdir} && timeout ${PROVIDER_TIMEOUT_SEC:-3540} opencode run -m opencode/minimax-m2.5-free "$(cat {prompt_file})"'
PROVIDER_CMD_pickle='cd {workdir} && timeout ${PROVIDER_TIMEOUT_SEC:-3540} opencode run -m opencode/big-pickle "$(cat {prompt_file})"'
#
# Note for opencode-backed providers:
# After first container start, run `opencode auth login` inside the container once;
# the `agent-home` named volume persists ~/.opencode credentials.

# --- Paths ---
# IMPORTANT: use 'export' so these are visible to provider subprocesses
# These are CONTAINER paths: the supervisor now runs inside the ai-agent container
# (repo mounted at /git/ai-server-agent, git roots at /git). Host deployments
# without the container would use host paths instead (e.g. /share/CACHEDEV1_DATA/…).
export AGENT_HOME="/git/ai-server-agent"
export GIT_DIR="/git"
export CONTAINER_GIT_DIR="/git"

# --- Admin Panel ---
# Set a token to enable the web admin panel (leave empty to disable)
ADMIN_TOKEN=""
PANEL_PORT=3000

# --- Telegram Message Limits ---
MAX_MESSAGE_LENGTH=4096
